# Server-only integrations. Leave blank while working on the local UI foundation.
# Powers mock interviews. Never expose with a NEXT_PUBLIC_ prefix — voice uses
# short-lived ephemeral tokens minted from this key server-side.
OPENAI_API_KEY=
OPENAI_INTERVIEW_MODEL=
OPENAI_RESEARCH_MODEL=
OPENAI_REALTIME_MODEL=
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DYNAMODB_TABLE=sweetplus-workspaces
AWS_UPLOAD_BUCKET=
AWS_SQS_QUEUE_URL=
DATABASE_URL=
AUTH_SECRET=
AUTH_COGNITO_ID=
AUTH_COGNITO_SECRET=
AUTH_COGNITO_ISSUER=
AUTH_APPLE_ENABLED=false
E2B_API_KEY=
# Feedback email (Resend). roleward.org publishes DMARC p=reject with strict
# alignment (adkim=s; aspf=s), so the Resend domain must be verified at the ROOT
# domain (roleward.org) — NOT the send.roleward.org subdomain Resend suggests.
# DKIM has to sign d=roleward.org or mail from the address below is rejected.
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=support@roleward.org
FEEDBACK_FROM_EMAIL=Roleward Feedback <feedback@roleward.org>

# Values exposed to the browser must use the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_APP_URL=http://localhost:3000
AWS_JUDGE_FUNCTION=
CRON_SECRET=

# Product analytics (optional — omit the key to disable analytics entirely)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Donations (optional). A Stripe Payment Link URL — leave blank and the
# Support button never renders. No secret key needed: Stripe hosts checkout.
NEXT_PUBLIC_STRIPE_DONATE_URL=
